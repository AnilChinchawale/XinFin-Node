INSTANCE_NAME=YOUR_NODE_NAME
CONTACT_DETAILS=YOUR_EMAIL_ADDRESS
NODE_TYPE=full
NETWORK=mainnet
LOG_LEVEL=2
SYNC_MODE=full
GC_MODE=full
ENABLE_RPC=false

# ══════════════════════════════════════════════════════════════
# RPC SECURITY — READ CAREFULLY
# ══════════════════════════════════════════════════════════════
# By default, RPC is DISABLED. Set ENABLE_RPC=true only if needed.
# When enabled, RPC binds to localhost (127.0.0.1) — NOT accessible
# from the internet. Use a reverse proxy with authentication for
# external access.
#
# NEVER include these namespaces in RPC_API:
#   debug   — debug_setHead can DESTROY your chain state
#   admin   — admin_startHTTP can open new listeners
#   personal — personal_importRawKey exposes key management
#   miner   — miner_stop can halt block production
#
# For validator nodes, do NOT include 'eth' — it exposes:
#   eth_sign, eth_sendTransaction, eth_accounts
# ══════════════════════════════════════════════════════════════

# RPC API — safe defaults (no signing, no debug)
RPC_API=net,web3,XDPoS
RPC_CORS_DOMAIN=http://localhost
RPC_ADDR=127.0.0.1
RPC_PORT=8545
RPC_VHOSTS=localhost

# WebSocket — same security applies
WS_API=net,web3,XDPoS
WS_ADDR=127.0.0.1
WS_ORIGINS=http://localhost
WS_PORT=8546

# Docker image — override for upgrades
# DOCKER_IMAGE=xinfinorg/xdposchain:v2.6.8
