INSTANCE_NAME=YOUR_NODE_NAME
CONTACT_DETAILS=YOUR_EMAIL_ADDRESS
NODE_NAME=YOUR_NODE_NAME
NODE_TYPE=full
NETWORK=testnet
LOG_LEVEL=2
SYNC_MODE=full
GC_MODE=full
ENABLE_RPC=false

# RPC — disabled by default, localhost-only when enabled
RPC_API=net,web3,XDPoS
RPC_CORS_DOMAIN=http://localhost
RPC_ADDR=127.0.0.1
RPC_PORT=8545
RPC_VHOSTS=localhost

# WebSocket
WS_API=net,web3,XDPoS
WS_ADDR=127.0.0.1
WS_ORIGINS=http://localhost
WS_PORT=8546
