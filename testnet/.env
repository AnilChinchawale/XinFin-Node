INSTANCE_NAME=XF_MasterNode
NODE_NAME=XF_MasterNode
CONTACT_DETAILS=YOUR_EMAIL_ADDRESS
SYNC_MODE=full
GC_MODE=full
NETWORK=testnet
LOG_LEVEL=2
ENABLE_RPC=false

# RPC — disabled by default
RPC_API=net,web3,XDPoS
RPC_CORS_DOMAIN=http://localhost
RPC_ADDR=127.0.0.1
RPC_PORT=8545
RPC_VHOSTS=localhost

# WebSocket — disabled by default
WS_API=net,web3,XDPoS
WS_ADDR=127.0.0.1
WS_ORIGINS=http://localhost
WS_PORT=8546
